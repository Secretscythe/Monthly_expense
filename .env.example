# SpendFlow Gmail SMTP Configuration
#
# 1. Your full Gmail address:
GMAIL_USER=your_email@gmail.com

# 2. Your 16-character Google App Password (NOT your normal Gmail password)
# Generated in 30 seconds from your Google Account:
# Go to: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification turned ON -> App passwords -> Name it 'SpendFlow' -> Copy the 16 letters)
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
